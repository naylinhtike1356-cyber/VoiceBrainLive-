<?xml version="1.0" encoding="utf-8"?><!--
   Sample backup rules file; uncomment and customize as necessary.
   See https://developer.android.com/guide/topics/data/autobackup
   for details.
   Note: This file is ignored for devices older than API 31
   See https://developer.android.com/about/versions/12/backup-restore
-->
<full-backup-content>
    <!-- Keep private keys, tokens, transcripts, and diagnostics out of cloud backup. -->
    <exclude domain="sharedpref" path="secure_settings.xml" />
    <exclude domain="sharedpref" path="github_updates_secure.xml" />
    <exclude domain="sharedpref" path="secure_settings" />
    <exclude domain="sharedpref" path="voice_history.xml" />
    <exclude domain="sharedpref" path="voice_history" />
    <exclude domain="file" path="action_records.txt" />
    <exclude domain="external" path="Logs/" />
</full-backup-content>
