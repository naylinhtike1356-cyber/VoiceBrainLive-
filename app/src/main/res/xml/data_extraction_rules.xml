<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_health_prefs.xml" />
        <!-- Exclude API keys, tokens, transcripts, and diagnostics from cloud backup. -->
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="sharedpref" path="github_updates_secure.xml" />
        <exclude domain="sharedpref" path="secure_settings" />
        <exclude domain="sharedpref" path="voice_history.xml" />
        <exclude domain="sharedpref" path="voice_history" />
        <exclude domain="file" path="action_records.txt" />
        <exclude domain="external" path="Logs/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_health_prefs.xml" />
        <!-- Transfer regular app data, but never private credentials or diagnostics. -->
        <include domain="sharedpref" path="." />
        <exclude domain="sharedpref" path="secure_settings.xml" />
        <exclude domain="sharedpref" path="github_updates_secure.xml" />
        <exclude domain="sharedpref" path="secure_settings" />
        <exclude domain="sharedpref" path="voice_history.xml" />
        <exclude domain="sharedpref" path="voice_history" />
    </device-transfer>
</data-extraction-rules>
