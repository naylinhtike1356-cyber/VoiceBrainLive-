<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D1117">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#161B22"
        app:elevation="2dp">

        <androidx.appcompat.widget.Toolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:title="ဦးနှောက် မှတ်ဉာဏ် စီမံခန့်ခွဲမှု"
            app:titleTextColor="#FFFFFF"
            app:navigationIcon="@android:drawable/ic_menu_revert" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="12dp">

            <!-- View Mode Switcher (Sleek Segmented Capsule) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_edit_text"
                android:orientation="horizontal"
                android:padding="3dp">

                <TextView
                    android:id="@+id/btnModeNeural"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@drawable/bg_gem"
                    android:text="🧠 ဦးနှောက်ကွန်ရက် (Neural)"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/btnModeList"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:background="@android:color/transparent"
                    android:text="📋 စာရင်းအသေးစိတ် (List)"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>

            <!-- Search Bar -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSearchBar"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                app:cardBackgroundColor="#21262D"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:strokeColor="#30363D"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@android:drawable/ic_menu_search"
                        app:tint="#8B949E" />

                    <EditText
                        android:id="@+id/etSearchMemory"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="မှတ်ဉာဏ်များ ရှာဖွေရန်..."
                        android:imeOptions="actionSearch"
                        android:inputType="text"
                        android:paddingHorizontal="10dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#6E7681"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/btnClearSearch"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@android:drawable/ic_menu_close_clear_cancel"
                        android:visibility="gone"
                        app:tint="#8B949E"
                        android:contentDescription="Clear" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Category Filter Chips -->
            <HorizontalScrollView
                android:id="@+id/scrollCategoryChips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:scrollbars="none">

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:singleSelection="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipAll"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="အားလုံး (All)"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="@color/design_default_color_primary_variant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFacts"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📌 အချက်အလက် (Facts)"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="@color/design_default_color_primary_variant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipHabits"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🧠 အလေ့အထ (Habits)"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="@color/design_default_color_primary_variant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipConversations"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="💬 စကားပြောမှတ်ဉာဏ် (AI)"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="@color/design_default_color_primary_variant" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipNotes"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 မှတ်စုများ (Notes)"
                        android:textColor="#FFFFFF"
                        app:chipBackgroundColor="@color/design_default_color_primary_variant" />
                </com.google.android.material.chip.ChipGroup>
            </HorizontalScrollView>

            <TextView
                android:id="@+id/tvMemoryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="စုစုပေါင်း မှတ်ဉာဏ် ၀ ခု"
                android:textColor="#8B949E"
                android:textSize="11sp" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Main Content Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- 1. Neural Brain View Mode -->
        <FrameLayout
            android:id="@+id/containerNeuralBrain"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#0A0E14"
            android:visibility="visible">

            <com.example.voicebrainlive.ui.components.NeuralBrainNetworkView
                android:id="@+id/neuralBrainView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <!-- Brain View Instruction Hint -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|center_horizontal"
                android:layout_marginTop="12dp"
                android:background="#801E293B"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:text="💡 ဆွဲ၍လှည့်ကြည့်နိုင်ပြီး အလင်းလုံးများကို နှိပ်၍ အချက်အလက် ကြည့်နိုင်သည်"
                android:textColor="#80D8FF"
                android:textSize="11sp" />

            <!-- Selected Node Interactive Bottom Card -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardSelectedNode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_margin="16dp"
                android:layout_marginBottom="88dp"
                android:visibility="gone"
                app:cardBackgroundColor="#161B22"
                app:cardCornerRadius="18dp"
                app:cardElevation="8dp"
                app:strokeColor="#38BDF8"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvSelectedNodeCategory"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="#0284C7"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="3dp"
                            android:text="📌 Fact"
                            android:textColor="#FFFFFF"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvSelectedNodeTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="ကားနံပါတ်"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <ImageButton
                            android:id="@+id/btnCloseSelectedCard"
                            android:layout_width="28dp"
                            android:layout_height="28dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            app:tint="#94A3B8"
                            android:contentDescription="Close" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvSelectedNodeContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="7C-1234 (အနက်ရောင်)"
                        android:textColor="#E2E8F0"
                        android:textSize="13sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="end"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnEditSelectedNode"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="✏️ ပြင်မည်"
                            android:textColor="#38BDF8"
                            android:textSize="12sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDeleteSelectedNode"
                            style="@style/Widget.MaterialComponents.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="🗑️ ဖျက်မည်"
                            android:textColor="#F87171"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </FrameLayout>

        <!-- 2. Detailed List View Mode -->
        <FrameLayout
            android:id="@+id/containerDetailedList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingTop="8dp"
                android:paddingBottom="96dp" />

            <TextView
                android:id="@+id/tvEmptyState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:padding="24dp"
                android:lineSpacingExtra="4dp"
                android:text="🧠 မှတ်ဉာဏ် အချက်အလက်များ မရှိသေးပါ။
+ ခလုတ်ကို နှိပ်၍ အချက်အလက်အသစ် ထည့်သွင်းနိုင်ပါသည်။"
                android:textColor="#8B949E"
                android:textSize="14sp"
                android:visibility="gone" />
        </FrameLayout>
    </FrameLayout>

    <!-- Floating Action Button for adding custom facts -->
    <com.google.android.material.floatingactionbutton.ExtendedFloatingActionButton
        android:id="@+id/fabAddMemory"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:backgroundTint="@color/assistant_primary"
        android:text="အသစ်ထည့်မည်"
        android:textColor="#FFFFFF"
        android:textStyle="bold"
        app:icon="@android:drawable/ic_input_add"
        app:iconTint="#FFFFFF" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>