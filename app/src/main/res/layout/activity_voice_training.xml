<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_gradient"
    android:padding="24dp">

    <!-- Header Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="32dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/white"
            android:contentDescription="@string/desc_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:text="အသံမှတ်သားခြင်း (Voice Profile)"
            android:textColor="@color/white"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="သင့်အသံကို သေချာမှတ်သားထားခြင်းဖြင့် ဆူညံသံများကြားတွင်လည်း သင့်ကိုသာ နားထောင်ပေးနိုင်မည် ဖြစ်ပါသည်။"
        android:textColor="@color/assistant_text_secondary"
        android:textSize="15sp"
        android:lineSpacingExtra="4dp"
        android:layout_marginBottom="24dp" />

    <!-- Progress Tracker -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#15FFFFFF"
        android:padding="16dp"
        android:layout_marginBottom="24dp">

        <TextView
            android:id="@+id/tvProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="၀ / ၅ မှတ်သားပြီး"
            android:textColor="@color/assistant_primary_light"
            android:fontFamily="sans-serif-medium"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <ProgressBar
            android:id="@+id/progressSamples"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:max="5"
            android:progress="0"
            android:progressTint="@color/assistant_primary_light"
            android:progressBackgroundTint="#20FFFFFF" />
    </LinearLayout>

    <!-- Sample Phrase Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#20FFFFFF"
        android:padding="24dp"
        android:gravity="center"
        android:layout_marginBottom="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အောက်ပါအတိုင်း ပြောပါ"
            android:textColor="#80FFFFFF"
            android:textSize="12sp"
            android:textAllCaps="true"
            android:letterSpacing="0.1"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvSamplePhrase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="ဟယ်လို ဗြူးဘရိန်း"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="4dp" />
    </LinearLayout>

    <!-- Recording Controls -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageButton
            android:id="@+id/btnRecord"
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:layout_gravity="center"
            android:background="@drawable/btn_mic_modern"
            android:src="@drawable/ic_mic_modern"
            android:contentDescription="Record"
            android:padding="28dp"
            android:scaleType="centerInside"
            android:elevation="8dp" />

        <!-- Mock Waveform/Animation Circle (visible when recording) -->
        <View
            android:id="@+id/recordAnimationView"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_mic_ripple"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="ခလုတ်ကို နှိပ်ပြီး အသံဖမ်းပါ"
        android:textColor="@color/assistant_text_secondary"
        android:textSize="14sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btnResetProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="?android:attr/selectableItemBackground"
        android:text="အသံမှတ်တမ်း ပြန်စပါ"
        android:textColor="#80FFFFFF"
        android:textAllCaps="false"
        android:textSize="13sp" />

</LinearLayout>
