<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/assistant_surface"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="8dp"
        android:paddingBottom="22dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="အော်တိုမေးရှင်း အသစ်ဖန်တီးရန်"
            android:textColor="@color/assistant_text"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="အချိန်နှင့် ခိုင်းစေချက်ကို တစ်နေရာတည်းတွင် သတ်မှတ်ပါ"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="အော်တိုမေးရှင်း ဖွင့်ထားမည်"
                    android:textColor="@color/assistant_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="သတ်မှတ်ထားသောအချိန်တွင် အလိုအလျောက် လုပ်ဆောင်မည်"
                    android:textColor="@color/assistant_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="12dp"
            android:layout_marginBottom="18dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Agent အသုံးပြုမည်"
                    android:textColor="@color/assistant_text"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI ဖြင့် အဖြေပြန်ကြားပြီး လုပ်ဆောင်မည်"
                    android:textColor="@color/assistant_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>
            <Switch
                android:id="@+id/switchLiveAgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="လုပ်ဆောင်ချက်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အော်တိုမေးရှင်းအမျိုးအစား"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="5dp" />
        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အချိန်ဇယား"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="လုပ်ဆောင်မည့်အချိန်"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="5dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etHour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:hint="နာရီ"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp" />
            <EditText
                android:id="@+id/etMinute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:hint="မိနစ်"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvMessageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ခိုင်းစေချက်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp" />
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|start"
            android:background="@drawable/bg_edit_text"
            android:hint="ဥပမာ - မနက်ခင်း ရာသီဥတု ပြောပြပေးပါ"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:padding="16dp"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/tvMusicLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="သီချင်းရှာဖွေရန်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp"
            android:visibility="gone" />
        <EditText
            android:id="@+id/etMusicQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="1"
            android:background="@drawable/bg_edit_text"
            android:hint="သီချင်း၊ artist သို့ playlist"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:padding="16dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="16dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvReminderBeforeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ကြိုတင်သတိပေးချက်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">
            <EditText
                android:id="@+id/etReminderMinutesBefore"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="number"
                android:hint="မိနစ်"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp"
                android:maxLength="3" />
            <EditText
                android:id="@+id/etReminderText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:background="@drawable/bg_edit_text"
                android:inputType="text"
                android:hint="ကြိုတင်ပြောမည့်စာ"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp"
                android:maxLines="1" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ပြန်လုပ်မည့်အစီအစဉ်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="7dp" />
        <Spinner
            android:id="@+id/spinnerDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp" />
    </LinearLayout>
</ScrollView>
