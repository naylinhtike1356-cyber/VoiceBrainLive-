<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/assistant_surface"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <TextView
            android:id="@+id/tvDialogTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="အော်တိုမေးရှင်း သတ်မှတ်ရန်"
            android:textColor="@color/assistant_text"
            android:textSize="20sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="If (အခြေအနေ) နှင့် Then (လုပ်ဆောင်ချက်များ) ကို သတ်မှတ်ပါ"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="16dp" />

        <!-- Master Switches -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="အော်တိုမေးရှင်း ဖွင့်ထားမည်"
                    android:textColor="@color/assistant_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="သတ်မှတ်ချိန် သို့မဟုတ် အသံဖြင့်ခေါ်လျှင် လုပ်ဆောင်မည်"
                    android:textColor="@color/assistant_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Switch
                android:id="@+id/switchEnabled"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingVertical="8dp"
            android:layout_marginBottom="12dp">
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Agent အသုံးပြုမည်"
                    android:textColor="@color/assistant_text"
                    android:textSize="14sp"
                    android:fontFamily="sans-serif-medium" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AI ဖြင့် အခြေအနေအရ တုံ့ပြန်လုပ်ဆောင်မည်"
                    android:textColor="@color/assistant_text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
            <Switch
                android:id="@+id/switchLiveAgent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Section: Basic Info -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အော်တိုမေးရှင်း အချက်အလက်"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etRoutineName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="အမည် (ဥပမာ - အိပ်ရာဝင်ချိန် / အလုပ်ခွင်မုဒ်)"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:paddingHorizontal="14dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အသံဖြင့် တိုက်ရိုက်ခေါ်ဆိုရန် စကားစု"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etTriggerPhrase"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="ဥပမာ - အလုပ်ဝင်တော့မယ် / အိပ်တော့မယ်"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:paddingHorizontal="14dp"
            android:inputType="text"
            android:layout_marginBottom="14dp" />

        <!-- Section: Trigger Condition (If) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="စတင်မည့် အခြေအနေ (If Condition)"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="အမျိုးအစား"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerType"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="စတင်မည့် အချိန် (နာရီ / မိနစ်)"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/etHour"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:hint="နာရီ"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp" />
            <EditText
                android:id="@+id/etMinute"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_edit_text"
                android:inputType="none"
                android:focusable="false"
                android:clickable="true"
                android:hint="မိနစ်"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="16dp" />
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ထပ်ခါထပ်ခါ လုပ်ဆောင်မည့် နေ့ရက်များ"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerDay"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="16dp" />

        <!-- Section: Actions (Then) -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="လုပ်ဆောင်ချက်များ (Then Actions)"
            android:textColor="@color/assistant_primary_light"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:layout_marginBottom="6dp" />

        <!-- Ringer Mode -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ဖုန်း အသံမုဒ် (Ringer Mode)"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerRingerMode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Volume -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="မီဒီယာ အသံပမာဏ (Media Volume %)"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etVolumePercent"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:hint="ဥပမာ - 50 (မပြောင်းလဲလိုပါက ကွက်လပ်ထားပါ)"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:paddingHorizontal="14dp"
            android:inputType="number"
            android:maxLength="3"
            android:layout_marginBottom="12dp" />

        <!-- Music Query -->
        <TextView
            android:id="@+id/tvMusicLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="သီချင်း သို့မဟုတ် အစီအစဉ် ဖွင့်ရန်"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etMusicQuery"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="1"
            android:background="@drawable/bg_edit_text"
            android:hint="ဥပမာ - အိပ်ရာဝင်သီချင်း သို့မဟုတ် ပျော်ရွှင်စေမည့် သီချင်း"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:padding="14dp"
            android:inputType="textCapSentences"
            android:layout_marginBottom="12dp" />

        <!-- Music Sleep Timer -->
        <TextView
            android:id="@+id/tvSleepTimerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="သီချင်း အလိုအလျောက် ပြန်ပိတ်မည့်အချိန် (Sleep Timer)"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <Spinner
            android:id="@+id/spinnerSleepTimer"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_edit_text"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="12dp" />

        <!-- Custom Command Message -->
        <TextView
            android:id="@+id/tvMessageLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ထပ်ဆောင်း ခိုင်းစေချက် / အသံဖြင့် သတိပေးမည့်စာ"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <EditText
            android:id="@+id/etMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="2"
            android:gravity="top|start"
            android:background="@drawable/bg_edit_text"
            android:hint="ဥပမာ - မနက်ခင်း ရာသီဥတု ပြောပြပေးပါ"
            android:textColorHint="@color/assistant_text_muted"
            android:textColor="@color/assistant_text"
            android:padding="14dp"
            android:inputType="textCapSentences|textMultiLine"
            android:layout_marginBottom="12dp" />

        <!-- Advance Reminder -->
        <TextView
            android:id="@+id/tvReminderBeforeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ကြိုတင်သတိပေးချက်"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="12sp"
            android:layout_marginBottom="4dp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">
            <EditText
                android:id="@+id/etReminderMinutesBefore"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:background="@drawable/bg_edit_text"
                android:inputType="number"
                android:hint="မိနစ် (ဥပမာ 10)"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="14dp"
                android:maxLength="3" />
            <EditText
                android:id="@+id/etReminderText"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="2"
                android:background="@drawable/bg_edit_text"
                android:inputType="text"
                android:hint="ကြိုတင်ပြောမည့်စာ"
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:paddingHorizontal="14dp"
                android:maxLines="1" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
