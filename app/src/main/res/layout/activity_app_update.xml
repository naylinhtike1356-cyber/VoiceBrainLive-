<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/assistant_bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_close_button"
                android:src="@android:drawable/ic_media_previous"
                android:contentDescription="@string/about_updates_back" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="16dp"
                android:text="@string/about_updates_title"
                android:textColor="@color/assistant_text"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- App Hero Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:gravity="center_horizontal">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:src="@drawable/luma_icon"
                android:contentDescription="@string/app_name" />

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name"
                android:textColor="@color/assistant_text"
                android:textSize="20sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvInstalledVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="14sp"
                android:gravity="center" />

            <TextView
                android:id="@+id/tvDistributionChannel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_status_pill"
                android:textColor="@color/assistant_primary_light"
                android:textSize="12sp"
                android:paddingHorizontal="14dp"
                android:paddingVertical="4dp" />
        </LinearLayout>

        <!-- Update Check & Action Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="အက်ပ် ဗားရှင်း အခြေအနေ"
                android:textColor="@color/assistant_text"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvUpdateStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:textColor="@color/assistant_text_secondary"
                android:accessibilityLiveRegion="polite"
                android:textSize="15sp"
                android:lineSpacingExtra="4dp" />

            <ProgressBar
                android:id="@+id/progressUpdate"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnCheckUpdate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="@string/about_updates_check"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- New Update Available Card (Hidden by default) -->
        <LinearLayout
            android:id="@+id/layoutNewUpdate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="ဗားရှင်းအသစ် ရရှိနေပါပြီ!"
                    android:textColor="@color/status_success"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvNewVersionBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_status_pill"
                    android:textColor="@color/status_success"
                    android:textSize="12sp"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:text="NEW" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvNewVersionInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/assistant_text"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvReleaseNotesHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="အသစ်ပါဝင်သော အချက်များ (Release Notes):"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvReleaseNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textColor="@color/assistant_text"
                android:textSize="14sp"
                android:textIsSelectable="true"
                android:lineSpacingExtra="3dp"
                android:background="#15FFFFFF"
                android:padding="12dp" />

            <!-- Download Progress section -->
            <LinearLayout
                android:id="@+id/layoutDownloadProgress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="16dp"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/progressDownload"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:progressTint="@color/assistant_secondary"
                    android:max="100" />

                <TextView
                    android:id="@+id/tvDownloadProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/assistant_text_secondary"
                    android:textSize="13sp"
                    android:gravity="center" />
            </LinearLayout>

            <Button
                android:id="@+id/btnDownloadInstall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="52dp"
                android:text="အသစ် ရယူတပ်ဆင်မည် (Download &amp; Install)"
                android:textColor="@color/white"
                android:background="@drawable/bg_button_primary"
                android:textAllCaps="false"
                android:layout_marginTop="16dp"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Source Configuration Card (GitHub Token / Private Repo) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GitHub Release ဆက်တင် (Optional)"
                android:textColor="@color/assistant_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Private repository ဖြစ်ပါက GitHub Personal Access Token (Contents: Read-only) ကို ဤနေရာတွင် လုံခြုံစွာ ထည့်သွင်းသိမ်းဆည်းနိုင်ပါသည်။"
                android:textColor="@color/assistant_text_muted"
                android:textSize="13sp"
                android:lineSpacingExtra="2dp" />

            <EditText
                android:id="@+id/etGitHubToken"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:minHeight="48dp"
                android:background="@drawable/bg_edit_text"
                android:hint="ghp_... သို့မဟုတ် github_pat_..."
                android:textColorHint="@color/assistant_text_muted"
                android:textColor="@color/assistant_text"
                android:textSize="14sp"
                android:inputType="textPassword"
                android:padding="12dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/btnSaveToken"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="Token သိမ်းမည်"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_button_primary"
                    android:textAllCaps="false"
                    android:textSize="13sp" />

                <View
                    android:layout_width="12dp"
                    android:layout_height="1dp" />

                <Button
                    android:id="@+id/btnClearToken"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:minHeight="44dp"
                    android:text="ဖျက်ပစ်မည်"
                    android:textColor="@color/assistant_text_secondary"
                    android:background="@drawable/bg_action_card"
                    android:textAllCaps="false"
                    android:textSize="13sp" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="32dp" />

    </LinearLayout>
</ScrollView>
