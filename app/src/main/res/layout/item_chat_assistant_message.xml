<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Assistant Message Bubble (Left-aligned with Sparkle icon) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="start">

        <!-- Sparkle Icon -->
        <TextView
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="✦"
            android:textColor="#669DF6"
            android:gravity="center"
            android:textSize="24sp"
            android:layout_marginEnd="12dp"
            android:layout_marginTop="2dp" />

        <!-- Message Content -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:maxWidth="280dp"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <TextView
                android:id="@+id/tvAssistantMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/assistant_text"
                android:textSize="16sp"
                android:lineSpacingMultiplier="1.3"
                android:lineSpacingExtra="4dp"
                android:textAppearance="@style/TextAppearance.MaterialComponents.Subtitle1" />

            <!-- Time and Actions Row -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="12dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tvAssistantTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/assistant_text_muted"
                    android:textSize="11sp"
                    android:layout_weight="1" />

                <ImageButton
                    android:id="@+id/btnAssistantCopy"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_edit"
                    app:tint="@color/assistant_text_muted"
                    android:contentDescription="@string/desc_copy"
                    android:padding="4dp"
                    android:scaleType="centerInside" />

                <ImageButton
                    android:id="@+id/btnAssistantShare"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:src="@android:drawable/ic_menu_share"
                    app:tint="@color/assistant_text_muted"
                    android:contentDescription="@string/desc_share"
                    android:padding="4dp"
                    android:scaleType="centerInside" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
