<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_section"
    android:orientation="vertical"
    android:padding="18dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📱 AI ထဖတ်ခိုင်းမည့် App များ"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:id="@+id/tvSelectedCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="ရွေးချယ်ထားသော App (၀) ခု"
                android:textColor="@color/assistant_primary_light"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnCloseDialog"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/assistant_text_secondary"
            android:contentDescription="Close" />
    </LinearLayout>

    <!-- Search Box -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:background="@drawable/bg_edit_text"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="12dp"
        android:layout_marginBottom="10dp">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@android:drawable/ic_menu_search"
            app:tint="@color/assistant_text_secondary"
            android:layout_marginEnd="8dp" />

        <EditText
            android:id="@+id/etSearchApp"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="App အမည် သို့မဟုတ် Package ရှာပါ..."
            android:textColor="@color/white"
            android:textColorHint="@color/assistant_text_muted"
            android:textSize="13sp"
            android:imeOptions="actionDone"
            android:inputType="text"
            android:maxLines="1" />

        <ImageButton
            android:id="@+id/btnClearSearchApp"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/assistant_text_muted"
            android:visibility="gone"
            android:contentDescription="Clear search" />
    </LinearLayout>

    <!-- Quick Action Chips -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        android:layout_marginBottom="10dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/chipFilterAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_status_pill"
                android:paddingHorizontal="12dp"
                android:text="အားလုံး (All)"
                android:textColor="@color/white"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterSelected"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="12dp"
                android:text="ရွေးထားသည်များ (Selected)"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipFilterPopular"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="12dp"
                android:text="💬 မက်ဆေ့ချ် / လူသုံးများ"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipActionSelectAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="12dp"
                android:text="✓ အားလုံးရွေးမည်"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="11sp"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/chipActionClearAll"
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:gravity="center"
                android:background="@drawable/bg_category_chip"
                android:paddingHorizontal="12dp"
                android:text="✗ အားလုံးဖြုတ်မည်"
                android:textColor="@color/assistant_text_secondary"
                android:textSize="11sp" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- App List & Loading Frame -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="360dp"
        android:layout_marginBottom="14dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvApps"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:scrollbars="vertical" />

        <ProgressBar
            android:id="@+id/pbLoadingApps"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_gravity="center"
            android:indeterminateTint="@color/assistant_primary_light" />

        <TextView
            android:id="@+id/tvEmptyApps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:text="ကိုက်ညီသော App မတွေ့ပါ"
            android:textColor="@color/assistant_text_muted"
            android:textSize="13sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Bottom Buttons -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelAppSelection"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackground"
            android:text="မလုပ်တော့ပါ"
            android:textColor="@color/assistant_text_secondary"
            android:textSize="13sp"
            android:layout_marginEnd="8dp" />

        <Button
            android:id="@+id/btnSaveAppSelection"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:background="@drawable/bg_button_primary"
            android:paddingHorizontal="24dp"
            android:text="သိမ်းဆည်းမည်"
            android:textColor="@color/white"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium" />
    </LinearLayout>

</LinearLayout>