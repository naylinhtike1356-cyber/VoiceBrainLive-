<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/chatSessionRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <Button
        android:id="@+id/btnConnectedAgent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:text="AI စကားပြောနှင့် Notion အကူအညီ"
        android:contentDescription="Open foreground text AI and read-only Notion agent" />

    <androidx.fragment.app.FragmentContainerView
        android:id="@+id/chatSessionContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />
</LinearLayout>
