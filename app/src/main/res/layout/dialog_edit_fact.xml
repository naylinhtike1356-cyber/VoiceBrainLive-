<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_settings_section"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="ခေါင်းစဉ် / အကြောင်းအရာ"
        android:textColor="@color/assistant_primary_light"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etFactKey"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:hint="ဥပမာ - ကားနံပါတ် / အကြိုက်ဆုံးအစားအစာ"
        android:textColor="#FFFFFF"
        android:textColorHint="@color/assistant_text_muted"
        android:background="@drawable/bg_edit_text"
        android:paddingHorizontal="14dp"
        android:layout_marginBottom="16dp"
        android:inputType="text"
        android:textSize="14sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="အချက်အလက် အသေးစိတ်"
        android:textColor="@color/assistant_primary_light"
        android:textSize="12sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="6dp" />

    <EditText
        android:id="@+id/etFactValue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="ဥပမာ - 7C-1234 (Toyota Crown အနက်) / ကြက်သားဒံပေါက်"
        android:textColor="#FFFFFF"
        android:textColorHint="@color/assistant_text_muted"
        android:background="@drawable/bg_edit_text"
        android:padding="14dp"
        android:minLines="3"
        android:gravity="top"
        android:inputType="textMultiLine"
        android:textSize="14sp" />

</LinearLayout>